#!/usr/bin/env bash
# pre-commit: keep secrets and personal data out of this public repo. No dependencies.
#
#   enable:   git config core.hooksPath .githooks
#   scan all: .githooks/pre-commit --all      (every tracked file, e.g. before publishing)
#   bypass:   git commit --no-verify          (think twice) / add the text  secret-ok  on a line to allow it
#
# Personal strings you never want published (your username, hostnames, ...) go one per line in the
# UNTRACKED file  .git/secret-denylist  (case-insensitive, fixed strings). That file is not committed.
set -u
root=$(git rev-parse --show-toplevel) || exit 1
cd "$root" || exit 1
mode=staged
[ "${1:-}" = "--all" ] && mode=all

fail=0
report() { printf '  \033[31m✗\033[0m %s\n' "$1"; fail=1; }

# ---- 1. files that should never be committed -----------------------------------------------
if [ "$mode" = all ]; then files=$(git ls-files); else files=$(git diff --cached --name-only --diff-filter=ACM); fi
while IFS= read -r f; do
  [ -z "$f" ] && continue
  case "$f" in
    *.pem|*.key|*.p12|*.pfx|*.kdbx|*id_rsa*|*id_ed25519*|.env|*/.env|.env.*|*guisettings*.xml*|*.sqlite|*.db)
      report "forbidden file: $f" ;;
  esac
done <<EOF
$files
EOF

# ---- 2. content patterns (label|extended regex) --------------------------------------------
LABELS=(
  "private IPv4 address"
  "MAC address"
  "password / secret / token / api key assignment"
  "private key block"
  "known token format (GitHub, AWS, Slack, OpenAI-style)"
  "absolute home directory path"
  "email address"
  "credentials inside a URL"
)
REGEXES=(
  '(^|[^0-9.])(10\.[0-9]{1,3}|192\.168|172\.(1[6-9]|2[0-9]|3[01]))\.[0-9]{1,3}\.[0-9]{1,3}([^0-9]|$)'
  '(^|[^0-9A-Fa-f:])([0-9A-Fa-f]{2}[:-]){5}[0-9A-Fa-f]{2}([^0-9A-Fa-f:]|$)'
  '(pass(word|wd)?|secret|token|api[_-]?key|apikey|auth)[A-Za-z_-]*[[:space:]]*[:=][[:space:]]*["'"'"']?[A-Za-z0-9/+_.@!#$%^&*-]{6,}'
  '-----BEGIN [A-Z ]*PRIVATE KEY-----'
  '(ghp_|gho_|ghu_|ghs_|github_pat_|AKIA|xox[baprs]-|sk-[A-Za-z0-9]{20,})[A-Za-z0-9_-]{8,}'
  '(/Users/[A-Za-z0-9._-]+/|/home/[a-z][a-z0-9_-]+/)'
  '[A-Za-z0-9._%+-]+@[A-Za-z0-9.-]+\.[A-Za-z]{2,}'
  '[a-z]+://[^/[:space:]:@]+:[^/[:space:]@]+@'
)

deny="$(mktemp)"; trap 'rm -f "$deny"' EXIT
have_deny=0
if [ -s "$root/.git/secret-denylist" ]; then
  grep -v -e '^[[:space:]]*$' -e '^#' "$root/.git/secret-denylist" > "$deny" && [ -s "$deny" ] && have_deny=1
fi

scan() { # $1 = file, stdin = lines to check (already filtered of secret-ok)
  local f=$1 line n=0 i hit
  while IFS= read -r line; do
    n=$((n + 1))
    case "$line" in *secret-ok*) continue ;; esac
    for i in "${!REGEXES[@]}"; do
      if printf '%s\n' "$line" | grep -E -q -- "${REGEXES[$i]}"; then
        # allow the project's own bot address in docs
        printf '%s\n' "$line" | grep -q 'noreply@' && [ "$i" = 6 ] && continue
        report "$f: ${LABELS[$i]}: $(printf '%s' "$line" | cut -c1-100)"
      fi
    done
    if [ "$have_deny" = 1 ] && printf '%s\n' "$line" | grep -F -i -q -f "$deny"; then
      report "$f: matches your local denylist: $(printf '%s' "$line" | cut -c1-100)"
    fi
  done
}

while IFS= read -r f; do
  [ -z "$f" ] && continue
  case "$f" in .githooks/*) continue ;; esac            # the hook itself contains the patterns
  [ -f "$f" ] || continue
  if [ "$mode" = all ]; then
    grep -I -q . "$f" 2>/dev/null || continue            # skip binary
    scan "$f" < "$f"
  else
    scan "$f" < <(git diff --cached -U0 --no-color -- "$f" | grep '^+' | grep -v '^+++' | sed 's/^+//')
  fi
done <<EOF
$files
EOF

if [ "$fail" -ne 0 ]; then
  printf '\n\033[31mCommit blocked.\033[0m Remove the data above, or add "secret-ok" on that line if it is a false positive.\n'
  exit 1
fi
exit 0
